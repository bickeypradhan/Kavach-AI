{
  "name": "factory-safety-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered Industrial Safety Monitoring Platform",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ai": "cd ai-service && uvicorn app.main:app --reload --port 8000",
    "dev": "node scripts/start-dev.js",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {}
}
